# Required for persistent APIs; configure a real MongoDB instance.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=bkig

# Generate independent random values for local use. Never commit real secrets.
JWT_SECRET=replace-with-at-least-32-random-bytes
OTP_SECRET=replace-with-another-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
APP_ENV=development
# Set true only for local development or automated testing. Never enable in production.
DEV_OTP_ENABLED=false
# Optional local officer bootstrap. Set true only with APP_ENV=development;
# credentials must be supplied in the ignored local .env and are never seeded in production.
DEV_OFFICER_ENABLED=false
DEV_OFFICER_EMAIL=
DEV_OFFICER_PASSWORD=

# SMTP is used for officer email OTP delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=your-address@example.com
SMTP_USERNAME=your-address@example.com
SMTP_PASSWORD=your-app-password

# Configure a real SMS provider for farmer phone verification and login OTPs.
# Without a provider, these routes fail clearly and do not claim delivery.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Open Government Data API key for the Ministry of Agriculture's AGMARKNET daily prices.
DATA_GOV_IN_API_KEY=
# The default resource is the official current daily mandi prices dataset.
DATA_GOV_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# BKIG agricultural assistant (backend only; never expose via VITE_ variables).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Per-model timeout. The fallback can be tried once when the primary times out or is unavailable.
GEMINI_TIMEOUT_SECONDS=17
# Exact allowed browser origins, comma separated.
CORS_ORIGINS=http://localhost:5173
